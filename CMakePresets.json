{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "description": "Windows + MSVC + Ninja。Visual Studio の開発者環境(x64)で実行する(cmake/vs_dev_env.ps1 を参照)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "GSIS_BUILD_TESTS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "release",
      "displayName": "Release(CUDA あり、sm_120)",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "GSIS_ENABLE_CUDA": "ON" }
    },
    {
      "name": "debug",
      "displayName": "Debug(CUDA あり、sm_120)",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "GSIS_ENABLE_CUDA": "ON" }
    },
    {
      "name": "release-cpu",
      "displayName": "Release(CUDA なし)",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "GSIS_ENABLE_CUDA": "OFF" }
    },
    {
      "name": "debug-cpu",
      "displayName": "Debug(CUDA なし)",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "GSIS_ENABLE_CUDA": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release-cpu", "configurePreset": "release-cpu" },
    { "name": "debug-cpu", "configurePreset": "debug-cpu" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "release", "inherits": "test-base", "configurePreset": "release" },
    { "name": "debug", "inherits": "test-base", "configurePreset": "debug" },
    { "name": "release-cpu", "inherits": "test-base", "configurePreset": "release-cpu" },
    { "name": "debug-cpu", "inherits": "test-base", "configurePreset": "debug-cpu" }
  ]
}
