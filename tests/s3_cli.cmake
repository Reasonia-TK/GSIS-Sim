# S3の入力契約と3モードの履歴・summaryを検査する。
file(MAKE_DIRECTORY "${OUT}")
file(READ "${CASE}" source)
string(REPLACE "type = \"diffuse_wall\"" "type = \"maxwell_wall\"\naccommodation = 0.5" source "${source}")
string(REPLACE "type = \"pressure_inlet\"" "type = \"mass_flow_inlet\"\nmass_flow = 1e-6" source "${source}")
string(APPEND source "\n[gsis]\ncfl_pbc=1\nmax_pbc=2\n[macro]\ninit_iterations=0\n")
file(WRITE "${OUT}/case.toml" "${source}")

function(invoke code)
  execute_process(COMMAND "${EXE}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
  if(NOT status EQUAL code)
    message(FATAL_ERROR "終了コード ${status} (期待 ${code}): ${error}\n${output}")
  endif()
  set(result "${output}" PARENT_SCOPE)
endfunction()

invoke(0 check-case "${OUT}/case.toml" --json --no-mesh)
string(JSON alpha GET "${result}" patches 2 accommodation)
string(JSON target GET "${result}" patches 0 target_mass_flow_kg_s)
string(JSON pressure GET "${result}" patches 0 pressure_Pa)
if(NOT alpha EQUAL 0.5 OR NOT target GREATER 0 OR NOT pressure GREATER 0)
  message(FATAL_ERROR "新境界のJSON契約に違反: ${result}")
endif()
foreach(bad "0" "-0.1" "1.1")
  string(REPLACE "accommodation = 0.5" "accommodation = ${bad}" invalid "${source}")
  file(WRITE "${OUT}/invalid.toml" "${invalid}")
  invoke(1 check-case "${OUT}/invalid.toml" --json --no-mesh)
  string(JSON ok GET "${result}" ok)
  if(ok)
    message(FATAL_ERROR "不正なαを受理しました")
  endif()
endforeach()
string(REPLACE "mass_flow = 1e-6" "mass_flow = 0" invalid "${source}")
file(WRITE "${OUT}/invalid.toml" "${invalid}")
invoke(1 check-case "${OUT}/invalid.toml" --json --no-mesh)
string(REPLACE "temperature = 273.15" "" invalid "${source}")
file(WRITE "${OUT}/invalid.toml" "${invalid}")
invoke(1 check-case "${OUT}/invalid.toml" --json --no-mesh)
invoke(0 run "${OUT}/case.toml" --mode "${MODE}" --out "${OUT}" --max-iter 2 --threads 1 --no-vtu)
file(READ "${OUT}/history.csv" history)
if(NOT history MATCHES "p_b_inlet_Pa")
  message(FATAL_ERROR "入口圧力の履歴がありません")
endif()
file(READ "${OUT}/summary.json" summary)
string(JSON pressure GET "${summary}" patches 0 pressure_Pa)
string(JSON target GET "${summary}" patches 0 target_mass_flow_kg_s)
string(JSON error GET "${summary}" patches 0 mass_flow_relative_error)
string(JSON alpha GET "${summary}" patches 2 accommodation)
if(NOT pressure GREATER 0 OR NOT target GREATER 0 OR NOT error GREATER_EQUAL 0 OR NOT alpha EQUAL 0.5)
  message(FATAL_ERROR "summaryの新境界出力に違反: ${summary}")
endif()
