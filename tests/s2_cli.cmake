# フェーズ8 S2: JSON は標準出力全体を解析し、余分な文字列も検出する。
file(MAKE_DIRECTORY "${OUT}")
file(READ "${CASE}" source)
string(REPLACE "mode = \"cis\"" "mode = \"${MODE}\"" source "${source}")
file(WRITE "${OUT}/case.toml" "${source}")

function(invoke code)
  execute_process(COMMAND "${EXE}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
  if(NOT status EQUAL code)
    message(FATAL_ERROR "終了コード ${status} (期待 ${code}): ${error}\n${output}")
  endif()
  set(result "${output}" PARENT_SCOPE)
endfunction()

if(SCENARIO STREQUAL "check")
  invoke(0 check-case "${OUT}/case.toml" --json --free-vram-bytes 4294967296)
  string(JSON ok GET "${result}" ok)
  string(JSON cells GET "${result}" mesh n_cells)
  string(JSON total GET "${result}" memory total)
  string(JSON count LENGTH "${result}" patches)
  if(NOT ok OR NOT cells EQUAL 96 OR NOT total GREATER 0 OR NOT count EQUAL 3)
    message(FATAL_ERROR "メッシュ・JSON・メモリの検査失敗: ${result}")
  endif()
  string(REGEX REPLACE "n = \\[[^\n]+\nrange = [^\n]+" "auto = true" source "${source}")
  file(WRITE "${OUT}/auto.toml" "${source}")
  invoke(0 check-case --json "${OUT}/auto.toml" --no-mesh)
  string(JSON automatic GET "${result}" velocity_grid auto)
  string(JSON n GET "${result}" velocity_grid n 0)
  string(JSON memory TYPE "${result}" memory)
  if(NOT automatic OR NOT n EQUAL 16 OR NOT memory STREQUAL "NULL")
    message(FATAL_ERROR "メッシュなし自動格子の検査失敗: ${result}")
  endif()
  invoke(1 check-case "${OUT}/absent.toml" --json)
  string(JSON ok GET "${result}" ok)
  string(JSON errors LENGTH "${result}" errors)
  if(ok OR errors LESS 1)
    message(FATAL_ERROR "入力エラーの JSON 検査失敗")
  endif()
  invoke(2 check-case --json --unknown)
  string(JSON ok GET "${result}" ok)
  if(ok)
    message(FATAL_ERROR "引数エラーの JSON 検査失敗")
  endif()
elseif(SCENARIO STREQUAL "stop")
  file(WRITE "${OUT}/STOP" "")
  invoke(0 run "${OUT}/case.toml" --out "${OUT}" --max-iter 3 --threads 1 --no-vtu)
  file(READ "${OUT}/summary.json" summary)
  string(JSON stopped GET "${summary}" stopped_by_user)
  if(NOT stopped OR NOT EXISTS "${OUT}/STOP" OR NOT EXISTS "${OUT}/fields.vtu" OR
      NOT EXISTS "${OUT}/boundary.vtu" OR NOT EXISTS "${OUT}/cells.csv")
    message(FATAL_ERROR "${MODE} の STOP または成果物の検査失敗")
  endif()
elseif(SCENARIO STREQUAL "run")
  file(REMOVE "${OUT}/STOP")
  invoke(0 run "${OUT}/case.toml" --out "${OUT}" --max-iter 2 --threads 1 --cells-csv --set macro.init_iterations=0)
  file(READ "${OUT}/summary.json" summary)
  string(JSON heat GET "${summary}" patches 0 heat_flow_W)
  string(JSON force LENGTH "${summary}" patches 0 force_N)
  string(JSON stopped GET "${summary}" stopped_by_user)
  if(NOT force EQUAL 3 OR stopped)
    message(FATAL_ERROR "${MODE} のパッチ出力の検査失敗")
  endif()
  if(MODE STREQUAL "gsis")
    string(JSON state GET "${summary}" conservation_diagnostics state)
    string(JSON correction GET "${summary}" conservation_diagnostics last_pbc_correction epsilon)
    string(JSON previous_correction GET "${summary}" pbc_change)
    if(NOT state STREQUAL "corrected_f" OR correction LESS 0 OR NOT correction STREQUAL previous_correction)
      message(FATAL_ERROR "補正後 f の診断の検査失敗")
    endif()
  elseif(MODE STREQUAL "nsf")
    string(JSON distribution GET "${summary}" memory_bytes)
    if(NOT distribution EQUAL 0 OR NOT EXISTS "${OUT}/fields.vtu")
      message(FATAL_ERROR "NSF のメモリ・VTU 検査失敗")
    endif()
    invoke(0 check-case "${OUT}/case.toml" --json)
    string(JSON f GET "${result}" memory distribution)
    if(NOT f EQUAL 0)
      message(FATAL_ERROR "NSF の f 見積もりが 0 でない")
    endif()
    invoke(0 pbc-run "${OUT}/case.toml" --out "${OUT}/legacy" --iterations 2 --threads 1 --cells-csv --tolerance 1e-5)
    file(SHA256 "${OUT}/cells.csv" actual)
    file(SHA256 "${OUT}/legacy/cells.csv" expected)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "NSF と pbc-run のセル値が違う")
    endif()
  endif()
endif()
